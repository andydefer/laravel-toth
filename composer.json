{
    "name": "andydefer/laravel-toth",
    "description": "Toth is a Laravel package for database backup and snapshot management with asynchronous task-based architecture.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Defer",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "andydefer/laravel-task": "^4.11.14",
        "andydefer/laravel-utils": "^0.9.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.29",
        "laravel/tinker": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "AndyDefer\\LaravelToth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\LaravelToth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\LaravelToth\\LaravelTothServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
